# Required to read laws (pipeline and Bring your own). Lookups, Pre-Flight and the API work without it.
ANTHROPIC_API_KEY=
# Optional model overrides (defaults shown)
ANTHROPIC_MODEL_PIPELINE=claude-opus-5-5
ANTHROPIC_MODEL_BYO=claude-sonnet-5-5
# Signs API keys issued on /developers (any long random string)
PROOFLINE_KEY_SECRET=
# Optional extra bill-status sources for Law Watch (free keys)
LEGISCAN_API_KEY=
OPENSTATES_API_KEY=
